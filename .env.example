# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renewable_energy
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# API Keys (optional - for real API integration)
MNRE_API_KEY=
MNRE_API_BASE_URL=https://mnre.gov.in/api
CEA_API_KEY=
CEA_API_BASE_URL=https://cea.nic.in/api
MINISTRY_POWER_API_KEY=
MINISTRY_POWER_BASE_URL=https://powermin.gov.in/api

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_SSE_URL=http://localhost:3001/api/events

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Scheduler Intervals (in minutes)
MNRE_FETCH_INTERVAL=60
CEA_FETCH_INTERVAL=15
MINISTRY_FETCH_INTERVAL=1440

# JWT Secret (for future user auth)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
